{
  "name": "web",
  "private": true,
  "version": "0.9.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "predev": "node scripts/build-sw.mjs",
    "build": "vite build",
    "prebuild": "node scripts/build-sw.mjs",
    "preview": "vite preview",
    "gtfs": "node scripts/fetch-gtfs.mjs && node scripts/build-gtfs.mjs",
    "gtfs:check": "node scripts/fetch-gtfs.mjs --check",
    "check": "svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@tailwindcss/vite": "^4.2.2",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^24.12.2",
    "gh-pages": "^6.3.0",
    "svelte": "^5.55.1",
    "svelte-check": "^4.4.6",
    "tailwindcss": "^4.2.2",
    "typescript": "~6.0.2",
    "vite": "^8.0.4"
  },
  "dependencies": {
    "lucide-svelte": "^1.0.1",
    "maplibre-gl": "^5.23.0"
  }
}
