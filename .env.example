# ── Priporočeno za produkcijo ────────────────────────────────────────────────
# Lasten Cloudflare Worker (glej worker/README.md). Ključ za ORS ostane na
# strežniku, OBA dobi CORS glave in predpomnjenje. Brez javnih posrednikov.
# VITE_OBA_PROXY=https://moha-mobil-proxy.<tvoj-subdomain>.workers.dev/oba
# VITE_ORS_PROXY=https://moha-mobil-proxy.<tvoj-subdomain>.workers.dev/ors

# ── Zasilno / lokalni razvoj ─────────────────────────────────────────────────
# Vite ključ ob gradnji vstavi kot BESEDILO v JavaScript paket — na javni strani
# ga lahko kdorkoli prebere in porabi kvoto. Uporabljaj samo lokalno.
VITE_ORS_KEY=your_openrouteservice_api_key_here

# Brez VITE_OBA_PROXY aplikacija rotira med javnima posrednikoma
# (corsproxy.io, allorigins) — odvisnost od tretje osebe.
